---
/* 첫 화면 = 무엇을 하는 회사인지 한 문장만. 제품 목록·캠퍼스·영상은 /home 과 /apps 에 그대로 있다.
   앱 랜딩(/apps/*)·법적 페이지·app-ads.txt 주소는 바꾸지 않았다. */
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <section class="hero front">
    <canvas class="hero-net" id="heroNet" aria-hidden="true"></canvas>
    <div class="wrap">
      <div class="hero-text">
        <p class="eyebrow on-dark">LOGICCRAFT · 사고력 EdTech 스튜디오</p>
        <h1>생각하는 힘을 키우는 <em>공간</em>을 만듭니다.</h1>
        <div class="hero-cta">
          <a href="/home/#campus" class="btn btn-primary">캠퍼스 둘러보기 <span class="arr">→</span></a>
          <a href="/about" class="btn btn-ghost">스튜디오 소개</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .front { min-height: calc(100svh - 72px); display: flex; align-items: center; }
  .front .wrap { width: 100%; }
</style>
